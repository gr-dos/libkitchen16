#!/usr/bin/env perl

use 5.040;
use warnings;
use autodie;
use File::Basename qw(dirname);
use Math::BigInt;
no warnings 'portable';

=head1 NAME

gen - generate the test corpus of tests/fpc

=head1 SYNOPSIS

  tests/fpc/gen [DIR]           write the data files into DIR (default: data next to gen)
  tests/fpc/gen --check [DIR]   verify the data files in DIR, write nothing

=head1 DESCRIPTION

Writes the data files that the programs of tests/fpc read (docs/spec/fpc.md,
"Tests"). Operands and results are bit patterns in hexadecimal, big-endian:
16 digits for a C<double>, 8 for a C<float> and a 32-bit integer. A result
written as C<N> is "any NaN" (the sign and payload of a NaN are not
significant). The expected results are computed with the host's IEEE 754
arithmetic (Perl's own C<double>s, with C<pack> and C<unpack>); the host is
only the oracle, and no result comes from any library of the project.

Every row is then verified again by a second, independent method: exact
integer arithmetic (Math::BigInt) and one rounding step written out by hand
(round to nearest, ties to even, gradual underflow, overflow to infinity).
The generator dies if the two methods differ anywhere, so the corpus is
only written when both agree. C<--check> runs the second method on files
already written. Zeros, infinities and NaNs follow the rules of the spec
and are decided by one shared table of rules (sub special).

Files (one row per line, fields separated by a space; lines starting with #
are comments):

  ADD.DAT SUB.DAT MUL.DAT DIV.DAT   A B R      a op b
  NEG.DAT                           A R        -a (exact bits, also NaNs)
  CMP.DAT                           A B C      C is <, = or > ; unordered gives >
  TOINT.DAT                         A I U      __FDI4 and __FDU4 results, 8 digits
  FROMINT.DAT                       L S U I W  the double of (long)L, (unsigned long)L,
                                               (int)(low word of L), (unsigned)(low word of L)
  D2F.DAT                           A F        (float)a
  F2D.DAT                           F D        (double)f

The pseudo-random part uses srand with a fixed seed (Perl's own generator
since 5.20, the same on every platform), so the output is deterministic.

=cut

my $check_only = @ARGV && $ARGV[0] eq '--check' ? shift @ARGV : 0;
my $dir = shift @ARGV // dirname($0) . '/data';

use constant {
  SIGN => 1 << 63,
  MASK => 0x7FFFFFFFFFFFFFFF,
  FRAC => 0xFFFFFFFFFFFFF,
  INF  => 0x7FF0000000000000,
  QNAN => 0x7FF8000000000000,
};
my @DBL = (53, -1074, 1023, 1023, 11);
my @FLT = (24, -149, 127, 127, 8);

# ---- bit patterns

sub bits ($d) { unpack 'Q>', pack 'd>', $d }
sub dbl ($b) { unpack 'd>', pack 'Q>', $b }
sub hx ($b) { sprintf '%016X', $b }
sub hx8 ($b) { sprintf '%08X', $b }
sub is_nan ($b) { (($b >> 52) & 0x7FF) == 0x7FF && ($b & FRAC) != 0 }
sub is_inf ($b) { ($b & MASK) == INF }
sub is_zero ($b) { ($b & MASK) == 0 }
sub sgn ($b) { $b >> 63 }
sub neg ($b) { $b ^ SIGN }
sub mk ($s, $e, $f) { ($s << 63) | ($e << 52) | $f }
sub up ($b) { $b + 1 }                     # next larger magnitude
sub down ($b) { ($b & MASK) ? $b - 1 : $b } # next smaller magnitude
sub p2 ($k) { bits(2.0**$k) }              # 2^k, k in -1022 .. 1023
sub fnan ($f) { (($f >> 23) & 0xFF) == 0xFF && ($f & 0x7FFFFF) != 0 }

# ---- the corpus builders

srand(20260601);
sub rnd32 () { int(rand(4294967296)) }
sub rnd64 () { (rnd32() << 32) | rnd32() }
sub rint ($n) { int(rand($n)) }

sub rdbl () {
  my $t = rint(10);
  my $s = rint(2);
  if ($t < 3) { return rnd64() }
  if ($t < 6) { return mk($s, 1023 - 40 + rint(81), rnd64() & FRAC) }
  if ($t == 6) {                                   # sparse mantissa
    my $f = 0;
    $f |= 1 << rint(52) for 1 .. 1 + rint(4);
    return mk($s, 1023 - 70 + rint(141), $f);
  }
  if ($t == 7) { return mk($s, 0, rnd64() & FRAC) } # subnormal
  if ($t == 8) { return mk($s, 1 + rint(80), rnd64() & FRAC) }     # small
  return mk($s, 1966 + rint(81), rnd64() & FRAC);   # large
}

my @S = (
  0, SIGN, bits(1), bits(-1), bits(2), bits(0.5), bits(3), bits(1.5), bits(-2.5),
  bits(10), bits(0.1), bits(1 / 3), bits(3.14159265358979), bits(1e10), bits(-1e-10),
  0x3FF0000000000001, 0x3FEFFFFFFFFFFFFF, p2(52), 0x4330000000000001, p2(53),
  0x4340000000000001,
  0x7FEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFE, 0xFFEFFFFFFFFFFFFF,
  0x0010000000000000, 0x000FFFFFFFFFFFFF, 0x0000000000000001, 0x8000000000000001,
  0x0000000000000003, 0x0008000000000000,
  p2(511), p2(-511), p2(512), p2(-512), p2(1023), bits(1e308), bits(1e-308),
  INF, neg(INF), QNAN, 0xFFF0000000000001,
);

# values next to the specials, for cancellation and ulp-level cases
my @NEAR;
for my $s (@S) {
  next if is_nan($s) || is_inf($s) || is_zero($s);
  push @NEAR, [ $s, up($s) ], [ $s, down($s) ], [ $s, neg(up($s)) ], [ up($s), neg(down($s)) ];
}

sub pairs_common () {
  my @p;
  for my $a (@S) { for my $b (@S) { push @p, [ $a, $b ] } }
  push @p, @NEAR;
  return @p;
}

sub sparse_odd ($bits) { (1 << ($bits - 1)) | rint(1 << ($bits - 1)) | 1 }   # odd, exactly $bits bits

sub pow2f ($k) { 2.0**$k }

# a double m * 2^k, exactly (m < 2^53)
sub mul2 ($m, $k) {
  my $d = $m + 0.0;
  while ($k > 500) { $d *= 2.0**500; $k -= 500 }
  while ($k < -500) { $d *= 2.0**-500; $k += 500 }
  return $d * 2.0**$k;
}

# ---- addition and subtraction

sub add_rows () {
  my @p = pairs_common();
  # ties: a plus (or minus) half an ulp, one and a half ulps, and just either side
  for my $e (60, 500, 1023, 1500, 2046) {
    for my $f (0, 1, FRAC, 0x8000000000000, rnd64() & FRAC, rnd64() & FRAC) {
      for my $s (0, 1) {
        my $a = mk($s, $e, $f);
        for my $b (mk(0, $e - 53, 0), mk(0, $e - 52, 0x8000000000000), mk(0, $e - 53, 1), mk(0, $e - 54, FRAC),
            mk(0, $e - 52, 0x8000000000001)) {
          push @p, [ $a, $b ], [ $a, neg($b) ];
        }
      }
    }
  }
  # small and subnormal operands, exact sums and cancellations
  for (1 .. 60) {
    my $k = mk(rint(2), rint(3), rnd64() & FRAC);
    push @p, [ $k, mk(rint(2), rint(3), rnd64() & FRAC) ];
  }
  # random
  for (1 .. 500) {
    my $a = rdbl();
    my $t = rint(4);
    my $b;
    if ($t == 0) { $b = rdbl() }
    elsif ($t == 1) {                              # exponent within 60 of a's
      my $e = (($a >> 52) & 0x7FF) + rint(121) - 60;
      $e = 1 if $e < 1;
      $e = 2046 if $e > 2046;
      $b = mk(rint(2), $e, rnd64() & FRAC);
    } elsif ($t == 2) {                            # a few ulps from -a
      $b = neg($a) + rint(9) - 4;
      $b = neg($a) if is_nan($b) || is_inf($b);
    } else { $b = rdbl() }
    push @p, [ $a, $b ];
  }
  return @p;
}

# ---- multiplication

sub mul_rows () {
  my @p = pairs_common();
  # 54-bit odd products: exact ties at normal exponents
  for (1 .. 60) {
    my ($m1, $m2);
    do { $m1 = sparse_odd(27); $m2 = sparse_odd(27) } until $m1 * $m2 >= 2**53;
    my ($k1, $k2) = (rint(81) - 40, rint(81) - 40);
    my ($s1, $s2) = (rint(2), rint(2));
    push @p, [ bits(mul2($m1, $k1)) ^ ($s1 << 63), bits(mul2($m2, $k2)) ^ ($s2 << 63) ];
  }
  # 54-bit all-ones product at the top of the range
  for my $t (969, 970, 971, 972) {
    my $x = 300 + rint(200);
    push @p, [ bits(mul2(2**27 - 1, $x)), bits(mul2(2**27 + 1, $t - $x)) ];
    push @p, [ bits(mul2(2**27 + 1, $x)), neg(bits(mul2(2**27 - 1, $t - $x))) ];
  }
  # exact ties in the subnormal range: odd * 2^x times 2^y, x + y = -1075
  for (1 .. 60) {
    my $x = -1 - rint(1074);
    my $y = -1075 - $x;
    my $k = (rint(2) ? sparse_odd(1 + rint(52)) : 2 * rint(1 << 26) + 1);
    my $a = bits(mul2($k, $x));
    my $b = bits(2.0**$y);
    ($a, $b) = ($b, $a) if rint(2);
    push @p, [ $a ^ (rint(2) << 63), $b ^ (rint(2) << 63) ];
  }
  # near-ties either side, and underflow / overflow boundaries
  for my $x (-1074, -1073, -1000, -600, -2, -1) {
    my $y = -1075 - $x;
    next if $y < -1022 || $y > 1023;
    for my $k (1, 3, 5, 7, 2**20 + 1, 2**52 + 1, 2**53 - 1) {
      push @p, [ bits(mul2($k, $x)), bits(2.0**$y) ], [ bits(mul2($k + 2, $x)), bits(2.0**$y) ];
    }
  }
  for (1 .. 40) {                                  # exponent sums near the edges
    my $ea = 1 + rint(2045);
    my $target = (rint(2) ? 1023 + 1020 + rint(10) : 1023 - 1080 + rint(10));
    my $eb = $target - $ea + 1023;
    $eb = 1 if $eb < 1;
    $eb = 2046 if $eb > 2046;
    push @p, [ mk(rint(2), $ea, rnd64() & FRAC), mk(rint(2), $eb, rnd64() & FRAC) ];
  }
  for (1 .. 450) {
    push @p, [ rdbl(), rdbl() ];
  }
  return @p;
}

# ---- division

sub div_rows () {
  my @p = pairs_common();
  # subnormal results exactly half way between two: odd * 2^x / 2^y with x - y = -1075
  for (1 .. 70) {
    my $y = 1 + rint(1023);
    my $x = $y - 1075;
    my $k = (rint(2) ? sparse_odd(1 + rint(53)) : 2 * rint(1 << 20) + 1);
    $k = 1 if $k >= 2**53;
    push @p, [ bits(mul2($k, $x)) ^ (rint(2) << 63), bits(2.0**$y) ^ (rint(2) << 63) ];
  }
  for my $y (1, 2, 100, 500, 1023) {                # one ulp each side of those
    my $x = $y - 1075;
    for my $k (1, 3, 5, 9, 2**30 + 1, 2**52 + 1, 2**53 - 1) {
      push @p, [ bits(mul2($k, $x)), bits(2.0**$y) ], [ bits(mul2($k + 2, $x)), bits(2.0**$y) ];
    }
  }
  # exact quotients, and quotients with long repeating fractions
  for (1 .. 60) {
    my ($q, $b) = (rint(1 << 24) + 1, rint(1 << 24) + 1);
    my ($s1, $s2) = (rint(2), rint(2));
    push @p, [ bits(mul2($q * $b, rint(61) - 30)) ^ ($s1 << 63), bits(mul2($b, rint(61) - 30)) ^ ($s2 << 63) ];
    push @p, [ bits(mul2($q, rint(61) - 30)), bits(mul2($b, rint(61) - 30)) ];
  }
  for (1 .. 40) {                                  # exponent differences near the edges
    my $ea = 1 + rint(2045);
    my $target = (rint(2) ? 1023 + 1020 + rint(10) : 1023 - 1080 + rint(10));
    my $eb = $ea - $target + 1023;
    $eb = 1 if $eb < 1;
    $eb = 2046 if $eb > 2046;
    push @p, [ mk(rint(2), $ea, rnd64() & FRAC), mk(rint(2), $eb, rnd64() & FRAC) ];
  }
  for (1 .. 450) {
    push @p, [ rdbl(), rdbl() ];
  }
  return @p;
}

# ---- comparison

sub cmp_rows () {
  my @p = pairs_common();
  for (1 .. 400) {
    my $a = rdbl();
    my $b = rint(3) ? rdbl() : (rint(2) ? $a : neg($a));
    $b = $a + rint(5) - 2 if rint(4) == 0 && !is_nan($a) && !is_inf($a) && !is_zero($a);
    push @p, [ $a, $b ];
  }
  for my $a (0, SIGN, 1, SIGN | 1, 0x3FF0000000000000, 0xBFF0000000000000, INF, neg(INF)) {
    push @p, [ $a, 0 ], [ $a, SIGN ], [ 0, $a ], [ SIGN, $a ];
  }
  return @p;
}

# ---- negation

sub neg_rows () {
  my @a = (@S, map { neg($_) } @S);
  push @a, rdbl() for 1 .. 300;
  return @a;
}

# ---- conversions to integers

sub toint_values () {
  my @a = @S;
  push @a, map { neg($_) } @S;
  my @d = (0.5, 0.75, 0.999999, 1.0, 1.5, 1.999999, 2.5, 100.9, 32767.9, 32768.0, 32768.5, 65535.0, 65535.9, 65536.0,
    65536.5, 1e6 + 0.5, 2147483646.5, 2147483647.0, 2147483647.5, 2147483647.99999, 2147483648.0, 2147483648.5,
    2147483649.0, 4294967294.5, 4294967295.0, 4294967295.5, 4294967295.99999, 4294967296.0, 4294967296.5,
    4294967297.0, 1e10, 1e15, 9007199254740992.0, 9.3e18, 1.8446744073709552e19, 1e30, 1e300);
  for my $d (@d) { push @a, bits($d), bits(-$d) }
  push @a, bits(-2147483647.0), bits(-2147483647.5), bits(-2147483648.0), bits(-2147483648.5), bits(-2147483648.99999),
    bits(-2147483649.0), bits(-2147483649.5), bits(-2147483650.0), bits(-4294967295.0), bits(-4294967296.0);
  push @a, map { p2($_) } (0 .. 63, -1 .. -4);
  push @a, map { up(p2($_)) } (0 .. 52);
  push @a, map { down(p2($_)) } (1 .. 40);
  push @a, map { neg(down(p2($_))) } (1 .. 40);
  push @a, map { neg(p2($_)) } (0 .. 40);
  for (1 .. 150) { push @a, mk(rint(2), 1023 + rint(36), rnd64() & FRAC) }        # up to 2^35
  for (1 .. 100) { push @a, mk(rint(2), 1023 - 3 + rint(8), rnd64() & FRAC) }     # around 1
  for (1 .. 100) { push @a, rdbl() }
  return @a;
}

sub fromint_values () {
  my @l = (0, 1, 2, 3, 0x7FFF, 0x8000, 0x8001, 0xFFFE, 0xFFFF, 0x10000, 0x10001, 0x7FFFFFFE, 0x7FFFFFFF, 0x80000000,
    0x80000001, 0xFFFFFFFE, 0xFFFFFFFF, 0x12345678, 0xDEADBEEF, 0xFFFF8000, 0xFFFF7FFF, 0x00008000);
  for my $k (0 .. 31) {
    my $p = 1 << $k;
    push @l, $p, ($p - 1) & 0xFFFFFFFF, ($p + 1) & 0xFFFFFFFF, (-$p) & 0xFFFFFFFF;
  }
  push @l, rnd32() for 1 .. 250;
  push @l, rnd32() & (0x1FFFF >> rint(16)) for 1 .. 100;
  push @l, ((-1 - (rnd32() & 0xFFFF)) & 0xFFFFFFFF) for 1 .. 60;
  return @l;
}

# ---- conversions to and from float

sub d2f_values () {
  my @a = (@S, map { neg($_) } @S);
  my @thr = (
    0x47EFFFFFE0000000,           # FLT_MAX
    0x47EFFFFFE0000001, 0x47EFFFFFEFFFFFFF, 0x47EFFFFFF0000000, 0x47EFFFFFF0000001, 0x47F0000000000000,
    0x47F0000000000001, 0x47EFFFFFDFFFFFFF,
    0x3810000000000000,           # FLT_MIN
    0x380FFFFFE0000000, 0x380FFFFFE0000001, 0x380FFFFFDFFFFFFF, 0x3810000000000001, 0x380FFFFFF0000000,
    0x380FFFFFF0000001, 0x380FFFFFEFFFFFFF,
    0x36A0000000000000,           # 2^-149
    0x369FFFFFFFFFFFFF, 0x3690000000000000, 0x3690000000000001, 0x36A8000000000000, 0x36A0000000000001,
    0x36B0000000000000, 0x36B8000000000000, 0x3680000000000000, 0x3670000000000000,
    0x3FF0000010000000, 0x3FF0000010000001, 0x3FF000000FFFFFFF, 0x3FF0000030000000, 0x3FF0000030000001,
    0x3FF000002FFFFFFF, 0x3FEFFFFFF0000000, 0x3FEFFFFFF8000000,
  );
  push @a, @thr, map { neg($_) } @thr;
  # every float exactly, halfway to the next and either side, across the exponent range
  for my $e (1 .. 20, 100 .. 104, 126, 127, 128, 150, 200, 254) {
    # a float with exponent e (biased), and random fraction bits
    my $de = $e - 127 + 1023;
    for my $f (0, 1, 0x7FFFFF, 0x400000, rnd32() & 0x7FFFFF, rnd32() & 0x7FFFFF) {
      my $base = mk(rint(2), $de, ($f << 29));
      push @a, $base, $base | 0x10000000, ($base | 0x10000000) + 1, ($base | 0x10000000) - 1, $base + 1;
    }
  }
  # subnormal floats and half way points between them
  for my $k (1, 2, 3, 4, 5, 7, 8, 100, 0x3FFFFF, 0x400000, 0x400001, 0x7FFFFF, 0x7FFFFE, rnd32() & 0x7FFFFF) {
    my $d = bits(mul2($k, -149));
    my $half = bits(mul2(2 * $k + 1, -150));
    push @a, $d, $half, up($half), down($half), neg($half), neg($d);
  }
  push @a, rdbl() for 1 .. 200;
  for (1 .. 100) { push @a, mk(rint(2), 1023 - 160 + rint(330), rnd64() & FRAC) }
  return @a;
}

sub f2d_values () {
  my @f = (0, 0x80000000, 0x3F800000, 0xBF800000, 0x40000000, 0x3F000000, 0x40400000, 0x7F7FFFFF, 0xFF7FFFFF,
    0x00800000, 0x007FFFFF, 0x00000001, 0x80000001, 0x00000003, 0x00400000, 0x7F800000, 0xFF800000, 0x7FC00000,
    0x7F800001, 0xFFC00000, 0xFFC12345, 0x7FFFFFFF, 0x3F800001, 0x3F7FFFFF, 0x4B800000, 0x4B000001, 0x5F000000,
    0x1F000000, 0x3DCCCCCD, 0x40490FDB, 0x00800001, 0x7F7FFFFE, 0x80800000, 0x807FFFFF);
  push @f, map { 1 << $_ } 0 .. 22;
  push @f, map { 0x80000000 | (1 << $_) } 0 .. 22;
  push @f, rnd32() for 1 .. 300;
  push @f, (rnd32() & 0x807FFFFF) for 1 .. 100;                     # subnormals
  return @f;
}

# ---- the oracle: host arithmetic

# rules for zeros, infinities and NaNs (a result of 'N' is any NaN); undef
# for two finite non-zero operands
sub special ($op, $a, $b) {
  return 'N' if is_nan($a) || is_nan($b);
  $b = neg($b), $op = '+' if $op eq '-';
  my ($za, $zb, $ia, $ib) = (is_zero($a), is_zero($b), is_inf($a), is_inf($b));
  my $s = sgn($a) ^ sgn($b);
  if ($op eq '+') {
    return sgn($a) == sgn($b) ? $a : 'N' if $ia && $ib;
    return $a if $ia;
    return $b if $ib;
    return sgn($a) && sgn($b) ? SIGN : 0 if $za && $zb;
    return $b if $za;
    return $a if $zb;
  } elsif ($op eq '*') {
    return 'N' if ($ia && $zb) || ($za && $ib);
    return INF | ($s << 63) if $ia || $ib;
    return $s << 63 if $za || $zb;
  } else {
    return 'N' if ($ia && $ib) || ($za && $zb);
    return INF | ($s << 63) if $ia || $zb;
    return $s << 63 if $za || $ib;
  }
  return undef;
}

sub host_arith ($op, $a, $b) {
  my $r = special($op, $a, $b);
  return $r if defined $r;
  my ($x, $y) = (dbl($a), dbl($b));
  my $s = sgn($a) ^ sgn($b);
  my $v;
  if ($op eq '+') { $v = $x + $y }
  elsif ($op eq '-') { $v = $x - $y }
  elsif ($op eq '*') { $v = $x * $y }
  else { $v = $x / $y }
  my $r2 = bits($v);
  return $r2 if $r2 & MASK;
  return $op eq '*' || $op eq '/' ? $s << 63 : 0;       # exact cancellation gives +0
}

sub host_cmp ($a, $b) {
  return '>' if is_nan($a) || is_nan($b);
  return '=' if is_zero($a) && is_zero($b);
  my ($x, $y) = (dbl($a), dbl($b));
  return $x < $y ? '<' : $x > $y ? '>' : '=';
}

sub host_toint ($a) {
  return (0, 0) if is_nan($a);
  my $x = dbl($a);
  my ($i, $u);
  if ($x >= 4294967296.0) { ($i, $u) = (0x7FFFFFFF, 0xFFFFFFFF) }
  elsif ($x <= -2147483649.0) { ($i, $u) = (0x80000000, 0x80000000) }
  else {
    my $t = int($x);
    $t = 0 if $t == 0;
    if ($t > 2147483647) { ($i, $u) = (0x7FFFFFFF, $t) }
    else { ($i, $u) = ($t & 0xFFFFFFFF, $t & 0xFFFFFFFF) }
  }
  return ($i, $u);
}

# (float)a as 8 hex digits worth of bits, or 'N'. Perl's pack 'f' turns every
# magnitude above FLT_MAX into an infinity, so the half-open range of
# magnitudes that round down to FLT_MAX is handled here.
sub host_d2f ($a) {
  return 'N' if is_nan($a);
  my $x = dbl($a);
  my $ax = $x < 0 ? -$x : $x;
  my $sign = sgn($a) ? 0x80000000 : 0;
  return $sign | 0x7F800000 if $ax >= dbl(0x47EFFFFFF0000000);    # 2^128 - 2^103 and up (ties to even is up)
  return $sign | 0x7F7FFFFF if $ax > dbl(0x47EFFFFFE0000000);
  my $f = unpack 'N', pack 'f>', $x;
  $f = $sign if ($f & 0x7FFFFFFF) == 0;                        # keep the sign of a zero
  return $f;
}

sub host_f2d ($f) {
  return 'N' if fnan($f);
  my $v = unpack 'f>', pack 'N', $f;
  return $v == 0 ? ($f & 0x80000000 ? SIGN : 0) : bits($v);
}

# ---- the second method: exact integers

sub decode ($b) {                  # finite non-zero: (sign, mantissa, exponent)
  my ($s, $e, $f) = ($b >> 63, ($b >> 52) & 0x7FF, $b & FRAC);
  return $e ? ($s, Math::BigInt->new("" . ($f | (1 << 52))), $e - 1075) : ($s, Math::BigInt->new("$f"), -1074);
}

sub bitlen ($n) { length($n->as_bin) - 2 }

# the value (-1)^sign * (n + sticky) * 2^e, rounded to nearest even in the
# format of @$fmt, as a bit pattern; sticky is a fraction below one unit of n
sub round_fmt ($sign, $n, $e, $sticky, $fmt) {
  my ($p, $qmin, $emax, $bias, $eb) = @$fmt;
  my $signbit = ($sign ? 1 : 0) << ($p - 1 + $eb);
  return $signbit if $n->is_zero;
  my $E = bitlen($n) - 1 + $e;
  my $q = $E - ($p - 1);
  $q = $qmin if $q < $qmin;
  my $shift = $q - $e;
  my $quo;
  if ($shift > 0) {
    $quo = $n->copy->brsft($shift);
    my $rem = $n->copy->bsub($quo->copy->blsft($shift));
    my $c = $rem->bcmp(Math::BigInt->bone->blsft($shift - 1));
    $quo->binc if $c > 0 || ($c == 0 && ($sticky || $quo->is_odd));
  } else {
    die "sticky bits with an exact value\n" if $sticky;
    $quo = $n->copy->blsft(-$shift);
  }
  if ($quo->bcmp(Math::BigInt->bone->blsft($p)) >= 0) { $quo->brsft(1); $q++ }
  return $signbit if $quo->is_zero;
  my $len = bitlen($quo);
  my $Er = $len - 1 + $q;
  return $signbit | (((1 << $eb) - 1) << ($p - 1)) if $Er > $emax;
  my $frac = 0 + $quo->copy->bstr;
  if ($len < $p) { return $signbit | $frac }
  return $signbit | (($Er + $bias) << ($p - 1)) | ($frac - (1 << ($p - 1)));
}

sub exact_arith ($op, $a, $b) {     # two finite non-zero operands
  my ($sa, $na, $ea) = decode($a);
  my ($sb, $nb, $eb) = decode($b);
  if ($op eq '-') { $sb ^= 1; $op = '+' }
  if ($op eq '+') {
    my $e = $ea < $eb ? $ea : $eb;
    my $x = $na->copy->blsft($ea - $e);
    my $y = $nb->copy->blsft($eb - $e);
    $x->bneg if $sa;
    $y->bneg if $sb;
    my $r = $x->badd($y);
    return 0 if $r->is_zero;
    my $s = $r->is_neg;
    return round_fmt($s, $r->babs, $e, 0, \@DBL);
  }
  my $s = $sa ^ $sb;
  return round_fmt($s, $na->copy->bmul($nb), $ea + $eb, 0, \@DBL) if $op eq '*';
  my $k = 130;
  my ($q, $rem) = $na->copy->blsft($k)->bdiv($nb);
  return round_fmt($s, $q, $ea - $eb - $k, !$rem->is_zero, \@DBL);
}

sub exact_cmp ($a, $b) {
  return '>' if is_nan($a) || is_nan($b);
  my ($ia, $ib) = (is_inf($a), is_inf($b));
  if ($ia || $ib) {
    my $va = $ia ? (sgn($a) ? -2 : 2) : 0;       # a finite value lies between the infinities
    my $vb = $ib ? (sgn($b) ? -2 : 2) : 0;
    return $va < $vb ? '<' : $va > $vb ? '>' : '=';
  }
  my $val = sub ($x) {
    return (Math::BigInt->bzero, 0) if is_zero($x);
    my ($s, $n, $e) = decode($x);
    return ($s ? $n->bneg : $n, $e);
  };
  my ($na, $ea) = $val->($a);
  my ($nb, $eb) = $val->($b);
  my $e = $ea < $eb ? $ea : $eb;
  my $x = $na->copy->blsft($ea - $e);
  my $y = $nb->copy->blsft($eb - $e);
  my $c = $x->bcmp($y);
  return $c < 0 ? '<' : $c > 0 ? '>' : '=';
}

sub exact_toint ($a) {
  return (0, 0) if is_nan($a);
  my $big = Math::BigInt->new(2)->bpow(40);
  my $t;
  if (is_inf($a)) { $t = sgn($a) ? $big->copy->bneg : $big }
  elsif (is_zero($a)) { $t = Math::BigInt->bzero }
  else {
    my ($s, $n, $e) = decode($a);
    my $m = $e >= 0 ? $n->copy->blsft($e) : $n->copy->brsft(-$e);   # truncates toward zero
    $t = $s ? $m->bneg : $m;
  }
  my $two31 = Math::BigInt->new(2)->bpow(31);
  my $two32 = Math::BigInt->new(2)->bpow(32);
  my ($i, $u);
  my $v = $t->copy;
  if ($v->bcmp($two31->copy->bneg) < 0) { ($i, $u) = (0x80000000, 0x80000000) }
  elsif ($v->bcmp($two31) < 0) {
    my $w = $v->copy->bmod($two32);                                  # two's complement
    ($i, $u) = (0 + $w->bstr, 0 + $w->bstr);
  } elsif ($v->bcmp($two32) < 0) { ($i, $u) = (0x7FFFFFFF, 0 + $v->bstr) }
  else { ($i, $u) = (0x7FFFFFFF, 0xFFFFFFFF) }
  return ($i, $u);
}

sub exact_d2f ($a) {
  return 'N' if is_nan($a);
  my $sign = sgn($a);
  return ($sign << 31) | 0x7F800000 if is_inf($a);
  return $sign << 31 if is_zero($a);
  my ($s, $n, $e) = decode($a);
  return round_fmt($s, $n, $e, 0, \@FLT);
}

sub exact_f2d ($f) {
  return 'N' if fnan($f);
  my $sign = $f >> 31;
  my $e = ($f >> 23) & 0xFF;
  my $m = $f & 0x7FFFFF;
  return mk($sign, 0x7FF, 0) if $e == 0xFF;
  return $sign << 63 if $e == 0 && $m == 0;
  if ($e == 0) {                                  # subnormal float: normalise
    my $k = 0;
    until ($m & 0x800000) { $m <<= 1; $k++ }
    $e = 1 - $k;
    $m &= 0x7FFFFF;
  }
  return mk($sign, $e - 127 + 1023, $m << 29);
}

# ---- verify rows of a file against the second method

sub nanmatch ($want, $got) { $want eq 'N' ? $got eq 'N' : defined $got && $got eq $want }

sub verify_line ($kind, @f) {
  if ($kind =~ /^[-+*\/]$/) {
    my ($a, $b, $r) = @f;
    ($a, $b) = (hex($a), hex($b));
    my $sp = special($kind, $a, $b);
    my $want = defined $sp ? $sp : exact_arith($kind, $a, $b);
    my $got = $r eq 'N' ? 'N' : hex($r);
    return $want eq 'N' ? $got eq 'N' : ($got ne 'N' && $got == $want);
  }
  if ($kind eq 'neg') { return hex($f[1]) == (hex($f[0]) ^ SIGN) }
  if ($kind eq 'cmp') { return exact_cmp(hex($f[0]), hex($f[1])) eq $f[2] }
  if ($kind eq 'toint') {
    my ($i, $u) = exact_toint(hex($f[0]));
    return $i == hex($f[1]) && $u == hex($f[2]);
  }
  if ($kind eq 'fromint') {
    my $l = hex($f[0]);
    my $sl = $l >= 0x80000000 ? $l - 4294967296 : $l;
    my $lw = $l & 0xFFFF;
    my $sw = $lw >= 0x8000 ? $lw - 65536 : $lw;
    my @want = map { my $v = $_; $v == 0 ? 0 : (round_fmt($v < 0, Math::BigInt->new("" . abs($v)), 0, 0, \@DBL)) } ($sl, $l, $sw, $lw);
    return join(' ', map { hx($_) } @want) eq join(' ', map { uc } @f[1 .. 4]);
  }
  if ($kind eq 'd2f') {
    my $want = exact_d2f(hex($f[0]));
    return $want eq 'N' ? $f[1] eq 'N' : ($f[1] ne 'N' && hex($f[1]) == $want);
  }
  if ($kind eq 'f2d') {
    my $want = exact_f2d(hex($f[0]));
    return $want eq 'N' ? $f[1] eq 'N' : ($f[1] ne 'N' && hex($f[1]) == $want);
  }
  die "bad kind $kind\n";
}

# ---- rows from the host method, as text

my %rows = (
  'ADD.DAT' => sub {
    map { my ($a, $b) = @$_; my $r = host_arith('+', $a, $b); join ' ', hx($a), hx($b), $r eq 'N' ? 'N' : hx($r) } add_rows()
  },
  'SUB.DAT' => sub {
    map { my ($a, $b) = @$_; my $r = host_arith('-', $a, $b); join ' ', hx($a), hx($b), $r eq 'N' ? 'N' : hx($r) } add_rows()
  },
  'MUL.DAT' => sub {
    map { my ($a, $b) = @$_; my $r = host_arith('*', $a, $b); join ' ', hx($a), hx($b), $r eq 'N' ? 'N' : hx($r) } mul_rows()
  },
  'DIV.DAT' => sub {
    map { my ($a, $b) = @$_; my $r = host_arith('/', $a, $b); join ' ', hx($a), hx($b), $r eq 'N' ? 'N' : hx($r) } div_rows()
  },
  'NEG.DAT' => sub { map { join ' ', hx($_), hx(neg($_)) } neg_rows() },
  'CMP.DAT' => sub { map { my ($a, $b) = @$_; join ' ', hx($a), hx($b), host_cmp($a, $b) } cmp_rows() },
  'TOINT.DAT' => sub { map { my ($i, $u) = host_toint($_); join ' ', hx($_), hx8($i), hx8($u) } toint_values() },
  'FROMINT.DAT' => sub {
    map {
      my $l = $_;
      my $sl = $l >= 0x80000000 ? $l - 4294967296 : $l;
      my $lw = $l & 0xFFFF;
      my $sw = $lw >= 0x8000 ? $lw - 65536 : $lw;
      join ' ', hx8($l), map { $_ == 0 ? hx(0) : hx(bits($_ + 0.0)) } ($sl, $l, $sw, $lw)
    } fromint_values()
  },
  'D2F.DAT' => sub { map { my $f = host_d2f($_); join ' ', hx($_), $f eq 'N' ? 'N' : hx8($f) } d2f_values() },
  'F2D.DAT' => sub { map { my $d = host_f2d($_); join ' ', hx8($_), $d eq 'N' ? 'N' : hx($d) } f2d_values() },
);
my %kind = (
  'ADD.DAT' => '+', 'SUB.DAT' => '-', 'MUL.DAT' => '*', 'DIV.DAT' => '/', 'NEG.DAT' => 'neg', 'CMP.DAT' => 'cmp',
  'TOINT.DAT' => 'toint', 'FROMINT.DAT' => 'fromint', 'D2F.DAT' => 'd2f', 'F2D.DAT' => 'f2d',
);

my $bad = 0;
mkdir $dir unless -d $dir;
for my $file (sort keys %rows) {
  my @lines;
  if ($check_only) {
    open my $fh, '<', "$dir/$file";
    @lines = grep { !/^#/ } map { chomp; $_ } <$fh>;
    close $fh;
  } else {
    my %seen;
    @lines = grep { !$seen{$_}++ } $rows{$file}->();
  }
  for my $line (@lines) {
    next if verify_line($kind{$file}, split ' ', $line);
    say STDERR "MISMATCH $file: $line";
    $bad++;
  }
  next if $check_only;
  open my $out, '>', "$dir/$file";
  print $out "# generated by tests/fpc/gen; do not edit. See the header of gen for the format.\n";
  print $out "$_\n" for @lines;
  close $out;
  say sprintf '%-12s %5d rows', $file, scalar @lines;
}
die "$bad rows differ between the host method and the exact method\n" if $bad;
say $check_only ? 'all rows verified' : 'all rows verified by the exact method';
