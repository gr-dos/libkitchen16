sub selftest {
  my @t = (
    ['1', '3FF0000000000000', 1, 0], ['-1', 'BFF0000000000000', 2, 0],
    ['1.5', '3FF8000000000000', 3, 0],     ['0.1', '3FB999999999999A', 3, 0], ['1e23', '44B52D02C7E14AF6', 4, 0],
    ['1e309', '7FF0000000000000', 5, 1], ['-1e309', 'FFF0000000000000', 6, 1],
    ['5e-324', '0000000000000001', 6, 1], ['2.4703282292062328e-324', '0000000000000001', 23, 1],
    ['2.4703282292062327e-324', '0000000000000000', 23, 1],
    ['-1e-400', '8000000000000000', 7, 1], ['-0', '8000000000000000', 2, 0],
    ['0e99999', '0000000000000000', 7, 0],
    ['1.7976931348623157e308', '7FEFFFFFFFFFFFFF', 22, 0],
    ['1.7976931348623159e308', '7FF0000000000000', 22, 1],
    ['2.2250738585072014e-308', '0010000000000000', 23, 0],
    ['2.2250738585072011e-308', '000FFFFFFFFFFFFF', 23, 1],
    ['9007199254740993', '4340000000000000', 16, 0],
    ['9007199254740993.0000001', '4340000000000001', 24, 0],
    ['1e', '3FF0000000000000', 1, 0], ['1e+', '3FF0000000000000', 1, 0],
    ['0x10', '0000000000000000', 1, 0], ['.', '0000000000000000', 0, 0],
    ['inFinity!', '7FF0000000000000', 8, 0], ['infinit', '7FF0000000000000', 3, 0],
    ['-nan(a_1)x', 'nan-', 9, 0], ['nan(a b)', 'nan+', 3, 0], ['nan(', 'nan+', 3, 0],
  );
  for my $t (@t) {
    my ($s, $bits, $off, $er) = @$t;
    $s =~ s/\\t/\t/g;
    next unless defined $bits;
    my @g = oracle($s);
    die "selftest: '$s' gave @g[0..2], expected $bits $off $er\n"
      unless $g[0] eq $bits && $g[1] == $off && $g[2] == $er;
  }
  my @g = oracle("  \t+.5e1x");
  die "selftest ws\n" unless $g[0] eq '4014000000000000' && $g[1] == 8;
}
selftest();

