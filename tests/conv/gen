# ------------------------------------------------------------------ halfway

# The midpoint between M * 2**E and (M + 1) * 2**E is (2M + 1) * 2**(E - 1).
sub halfway ($file, $m, $e, $variant, $form) {
  my ($n, $dp) = exact($m->copy->bmul(2)->binc, $e - 1);
  my $s = $variant eq 'mid'    ? scaled($n, $dp, '', $form)
        : $variant eq 'above'  ? scaled($n, $dp, '1', $form)
        : $variant eq 'zeros'  ? scaled($n, $dp, '0' x 7, $form)
        : $variant eq 'below'  ? scaled($n->copy->bdec, $dp, '', $form)
        : $variant eq 'below9' ? scaled($n->copy->bdec, $dp, '9' x 7, $form)
        : die;
  emit($file => $s);
  emit($file => "-$s") if $e % 61 == 0;
}

