=head1 NAME

gen - generate the data files of tests/conv

=head1 SYNOPSIS

  tests/conv/gen [--check]

=head1 DESCRIPTION

Writes tests/conv/data/*.DAT (committed). Each line of a data file is

  BITS OFFSET ERR STRING

separated by single spaces, where

=over

=item BITS

the expected result as 16 hex digits (the IEEE 754 binary64 bits, upper
case), or C<nan+> or C<nan-> when the result is a NaN: only "is a NaN" and
its sign are compared;

=item OFFSET

the expected C<endptr> offset from the start of the string, in decimal (0
when no conversion can be made);

=item ERR

C<R> if C<errno> must be C<ERANGE> after the call, C<-> if it must be left
alone;

=item STRING

the input, to the end of the line, with every byte except the printable ASCII
characters 0x21 to 0x7E other than the backslash written as C<\xHH> (two
lower case hex digits); the backslash is C<\x5c>. So the string never contains a
space, a backslash followed by anything but C<xHH>, or a line end, and the
empty string is an empty field (the line ends after the third space).

=back

The expected values do not come from the host's C library. They are computed
here, from the syntax rules of docs/spec/conv.md, by exact integer
arithmetic (Math::BigInt): the rounding of the value of the decimal digits
to the nearest double, ties to even, gradual underflow, and the C<ERANGE>
rules (overflow; non-zero rounding to zero; inexact subnormal). The host is
the cross-check: with C<--check> every decimal result is compared with
Perl's own string to number conversion (which uses the host's C library),
and a sample is verified again with a second method, exact rational
arithmetic (Math::BigRat) on the neighbouring doubles. Any difference is
reported and the exit status is 1. The generator also runs a self test of
known values before it writes anything.

The corpus is deterministic (fixed seed).

=cut

my $check = grep { $_ eq '--check' } @ARGV;

# ------------------------------------------------------------------ oracle

my $TWO52 = Math::BigInt->new(2)->bpow(52);
my $TWO53 = Math::BigInt->new(2)->bpow(53);

sub bitlen ($n) { length($n->as_bin) - 2 }

# Round DIGITS * 10**E (DIGITS a positive BigInt) to a double. Returns
# (magnitude bits, erange, inexact).
sub round_dec ($d, $e) {
  my ($num, $den) = $e >= 0
    ? ($d->copy->bmul(Math::BigInt->new(10)->bpow($e)), Math::BigInt->bone)
    : ($d->copy, Math::BigInt->new(10)->bpow(-$e));
  my $s = bitlen($num) - bitlen($den) - 53;
  $s = -1074 if $s < -1074;
  my ($q, $r, $final_dn);
  while (1) {
    my ($n, $dn) = ($num->copy, $den->copy);
    if ($s >= 0) { $dn->blsft($s) } else { $n->blsft(-$s) }
    ($q, $r) = $n->bdiv($dn);
    $final_dn = $dn;
    last if $q < $TWO53;
    $s++;
  }
  my $dn = $final_dn;
  my $inexact = !$r->is_zero;
  my $c = $r->copy->blsft(1)->bcmp($dn);
  $q->binc if $c > 0 || ($c == 0 && $q->is_odd);
  if ($q == $TWO53) { $q = $TWO52->copy; $s++ }
  return ('0000000000000000', 1, 1) if $q->is_zero;                 # underflow to zero
  if ($q < $TWO52) {                                # subnormal (s is -1074)
    return (hexbits($q), $inexact ? 1 : 0, $inexact);
  }
  my $biased = $s + 1075;
  return ('7FF0000000000000', 1, 1) if $biased >= 2047;
  my $bits = Math::BigInt->new($biased)->blsft(52)->badd($q->copy->bsub($TWO52));
  return (hexbits($bits), 0, $inexact);
}

# Bits are kept as 16 hex digit strings.
sub hexbits ($n) {
  return $n if !ref $n && $n =~ /^[0-9A-F]{16}$/;
  my $h = ref $n ? substr($n->as_hex, 2) : sprintf('%x', $n);
  return uc(('0' x (16 - length $h)) . $h);
}

# Parse the initial portion of $str by the spec. Returns
# (expected bits string, offset, erange, decimal parts or undef).
sub oracle ($str) {
  my $pos = 0;
  $pos++ while $pos < length($str) && substr($str, $pos, 1) =~ /^[ \t\n\x0b\x0c\r]$/;
  my $neg = 0;
  if (substr($str, $pos, 1) =~ /^[+-]$/) { $neg = substr($str, $pos, 1) eq '-'; $pos++ }
  my $signbit = $neg ? '8' : '0';
  pos($str) = $pos;
  if ($str =~ /\G(?:([0-9]+)(?:\.([0-9]*))?|\.([0-9]+))(?:[eE]([+-]?)([0-9]+))?/gc) {
    my $end = pos($str);
    my ($ip, $fp, $fp2, $esign, $edigits) = ($1, $2, $3, $4, $5);
    $ip //= '';
    $fp = $fp2 if defined $fp2;
    $fp //= '';
    my $e10 = 0;
    if (defined $edigits) {
      (my $t = $edigits) =~ s/^0+//;
      $t = '0' if $t eq '';
      $e10 = length($t) > 7 ? 10_000_000 : $t + 0;
      $e10 = -$e10 if $esign eq '-';
    }
    (my $digits = $ip . $fp) =~ s/^0+//;
    my $scale = $e10 - length($fp);
    if ($digits eq '') {
      return ($signbit . '000000000000000', $end, 0, undef);
    }
    $digits =~ s/(0+)$// and $scale += length $1;
    my $ordinal = length($digits) + $scale;
    my ($mag, $erange);
    if ($ordinal >= 311) {
      ($mag, $erange) = ('7FF0000000000000', 1);
    } elsif ($ordinal <= -326) {
      ($mag, $erange) = ('0000000000000000', 1);
    } else {
      ($mag, $erange) = round_dec(Math::BigInt->new($digits), $scale);
    }
    my $h = $mag;
    $h = sprintf('%X', hex(substr($h, 0, 1)) | ($neg ? 8 : 0)) . substr($h, 1);
    return ($h, $end, $erange, [$digits, $scale]);
  }
  pos($str) = $pos;
  if ($str =~ /\G(inf(?:inity)?)/gci) {
    return ($neg ? 'FFF0000000000000' : '7FF0000000000000', pos($str), 0, undef);
  }
  pos($str) = $pos;
  if ($str =~ /\Gnan(?:\([A-Za-z0-9_]+\))?/gci) {
    return ($neg ? 'nan-' : 'nan+', pos($str), 0, undef);
  }
  return ('0000000000000000', 0, 0, undef);
}

