sub randint ($n) { int rand $n }

# The digits of N with K decimal places, as "DDD.FFF" ($form 0) or "DDDe-K"
# ($form 1); $suffix is a string of digits appended after the last place.
sub scaled ($n, $k, $suffix = '', $form = 0) {
  my $digits = $n->bstr . $suffix;
  $k += length $suffix;
  if ($form) {
    return $k ? "${digits}e-$k" : $digits;
  }
  return $digits if $k == 0;
  $digits = ('0' x ($k - length($digits) + 1)) . $digits if length($digits) <= $k;
  return substr($digits, 0, length($digits) - $k) . '.' . substr($digits, -$k);
}

# The exact decimal of M * 2**E, as a (BigInt, decimal places) pair.
sub exact ($m, $e) {
  return ($m->copy->blsft($e), 0) if $e >= 0;
  return ($m->copy->bmul(Math::BigInt->new(5)->bpow(-$e)), -$e);
}

