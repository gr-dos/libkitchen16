    $m = $TWO53->copy->bdec if $e % 31 == 0;
    $i++;
    halfway(half => $m, $e, 'mid', $i % 2);
    halfway(half2 => $m, $e, ('above', 'below', 'below9', 'zeros')[$i % 4], $i % 3 == 0 ? 1 : 0) if $i % 6 == 0;
