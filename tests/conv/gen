sub escape ($s) {
  $s =~ s{([^\x21-\x5b\x5d-\x7e])}{sprintf '\\x%02x', ord $1}ger;
}

sub emit ($file, $str) {
  my ($bits, $off, $erange, $parts) = oracle($str);
  my $line = join ' ', $bits, $off, $erange ? 'R' : '-', escape($str);
  die "line too long for the test programs: $file\n" if length($line) > 2000;
  unless ($fh{$file}) {
    open $fh{$file}, '>', "$datadir/$file.DAT";
    binmode $fh{$file};
  }
  print { $fh{$file} } "$line\n";
  $count{$file}++;
  verify($str, $bits, $off, $erange, $parts, $count{$file}) if $check && $parts;
}

# --------------------------------------------------- cross-check (--check)

sub rat_of_bits ($mag) {
  my $b = Math::BigInt->from_hex('0x' . $mag);
  my $ex = $b->copy->brsft(52)->numify;
  my $m = $b->copy->band($TWO52->copy->bdec);
  if ($ex == 0) { $ex = 1 } else { $m->badd($TWO52) }
  my $p = $ex - 1075;
  return $p >= 0 ? Math::BigRat->new($m->blsft($p)) : Math::BigRat->new($m, Math::BigInt->new(2)->bpow(-$p));
}

sub verify ($str, $bits, $off, $erange, $parts, $n) {
  # 1. the host's conversion, for the numeric prefix
  my $prefix = substr($str, 0, $off);
  $prefix =~ s/^[ \t\n\x0b\x0c\r]+//;
  my $host = unpack 'H16', pack 'd>', 0 + $prefix;
  (my $hostmag = uc $host) =~ s/^8(?=0{15}$)/0/;
  (my $ormag = $bits) =~ s/^8(?=0{15}$)/0/;   # Perl drops the sign of a zero
  if ($hostmag ne $ormag) {
    $problems++;
    warn "host differs: '" . escape($str) . "' oracle $bits host " . uc($host) . "\n" if $problems < 20;
  }
  # 2. an independent exact check on a sample: v lies between the midpoints
  # to the neighbouring doubles, ties to even
  return if $n % 5;
  my ($digits, $scale) = @$parts;
  my $v = Math::BigRat->new(Math::BigInt->new($digits));
  $v = $scale >= 0 ? $v * Math::BigInt->new(10)->bpow($scale) : $v / Math::BigInt->new(10)->bpow(-$scale);
  (my $mag = $bits) =~ s/^([0-7]|[89A-F])/sprintf '%X', hex($1) & 7/e;
  my $x = Math::BigInt->from_hex("0x$mag");
  if ($x >= Math::BigInt->from_hex('0x7FF0000000000000')) {
    # overflow: v is at least the midpoint above the largest finite value
    my $max = rat_of_bits('7FEFFFFFFFFFFFFF');
    my $mid = $max + Math::BigRat->new(Math::BigInt->new(2)->bpow(970));
    unless ($v >= $mid) { $problems++; warn "verify overflow: " . escape($str) . "\n" }
    return;
  }
  my $cur = rat_of_bits($mag);
  my $lo = $x->is_zero ? undef : rat_of_bits(hexbits($x->copy->bdec));
  my $hi = rat_of_bits(hexbits($x->copy->binc));
  my $ok = 1;
  my $odd = $x->is_odd;
  if (defined $lo) {
    my $mid = ($lo + $cur) / 2;
    $ok = 0 if $v < $mid || ($v == $mid && $odd);
  }
  my $midh = ($cur + $hi) / 2;
  $ok = 0 if $v > $midh || ($v == $midh && $odd);
  unless ($ok) { $problems++; warn "verify failed: " . escape($str) . " $bits\n" }
}

