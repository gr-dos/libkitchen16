    1000000000000000, 1234567890123456, 4503599627370495, 4503599627370496, 4503599627370497, 9007199254740991, 9007199254740992, 9007199254740994, 9007199254740996);
  push @ivals, map { 2**$_ } 20 .. 52;
  push @ivals, map { 2**$_ - 1 } 20 .. 53;
