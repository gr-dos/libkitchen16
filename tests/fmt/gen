#!/usr/bin/env perl

use 5.040;
use warnings;
no warnings 'portable';
use autodie;
use Math::BigInt;
use File::Basename qw(dirname);
use File::Path qw(make_path);
use Getopt::Long;

=head1 NAME

gen - write the corpora of tests/fmt and tests/fmtio

=head1 SYNOPSIS

  tests/fmt/gen [--verify] [--scale N] [--out DIR] [--fmtio DIR]

=head1 DESCRIPTION

Writes the data files of tests/fmt (default tests/fmt/data) and tests/fmtio
(tests/fmtio/data/pc.dat, tests/fmtio/pc.expect). The programs read them;
nothing is converted from text to double on the target.

Each data line has five tab-separated fields:

  MODE  FORMAT  ARGS  EXPECTED  RETURN

MODE is C<P> (output into a roomy buffer) or C<N>K (snprintf and vsnprintf
with n = K; EXPECTED is still the whole output and RETURN its length, the
program truncates). FORMAT and EXPECTED have C<\\>, bytes below 0x20 and
bytes above 0x7e written as C<\\xHH> (C<\\t>, C<\\n>, C<\\r> and C<\\\\> too).
ARGS are space-separated tokens, spaces inside a string written C<\\x20>:

  i:N        an int (-32768..65535)
  l:N        a long (-2147483648..4294967295)
  d:HEX16    a double, as its 16 hex digits (sign bit first)
  s:TEXT     a string (escaped as above)
  S:         a null string pointer

The expected output is computed here by a model of docs/spec/fmt.md written
for this generator (the exact decimal digits come from Math::BigInt
arithmetic on the binary value). The host's own C<sprintf> (over the host's C
library) is the oracle for every valid specification: with --verify each
line is also formatted by Perl's C<sprintf>, and any difference is reported
(the committed files are written with the model's output, which differs from
Perl's only where the spec says so, listed in tests/fmt/README.txt).

=cut

my %opt = (scale => 2, out => dirname($0) . '/data', fmtio => dirname($0) . '/../fmtio');
GetOptions(\%opt, 'verify', 'scale=i', 'out=s', 'fmtio=s', 'check=s') or die "usage\n";

# ------------------------------------------------------------------ values

my @ints16 = do {
  my %s;
  my @v = (0, 1, 2, 3, 5, 7, 9, 10, 11, 99, 100, 101, 127, 128, 129, 255, 256, 257, 999, 1000, 1001,
    9999, 10000, 10001, 32766, 32767, 32768, 65535, 65534, 12345, 54321, 0x7f7f, 0x8000, 0x8001, 0xabcd);
  for my $k (0 .. 15) { push @v, (1 << $k) - 1, 1 << $k, (1 << $k) + 1 }
  for my $k (0 .. 5) { my $p = 8**$k; push @v, $p - 1, $p, $p + 1 }
  for my $k (0 .. 4) { my $p = 10**$k; push @v, $p - 1, $p, $p + 1 }
  for my $k (0 .. 3) { my $p = 16**$k; push @v, $p - 1, $p, $p + 1 }
  # 16-bit patterns; d and i show them as signed, the others as unsigned
  grep { !$s{$_}++ } map { $_ & 0xFFFF } @v, map { -$_ } @v;
};

my @longs = do {
  my %s;
  my @v = (0, 1, 2, 7, 10, 99, 100, 255, 65535, 65536, 65537, 99999, 100000, 1000000, 123456789,
    2147483646, 2147483647, 2147483648, 2147483649, 4294967295, 4294967294, 305419896, 0xdeadbeef);
  for my $k (0 .. 31) { push @v, (1 << $k) - 1, 1 << $k, (1 << $k) + 1 }
  for my $k (0 .. 10) { my $p = 8**$k; push @v, $p - 1, $p, $p + 1 }
  for my $k (0 .. 9) { my $p = 10**$k; push @v, $p - 1, $p, $p + 1 }
  for my $k (0 .. 7) { my $p = 16**$k; push @v, $p - 1, $p, $p + 1 }
  grep { !$s{$_}++ } map { $_ & 0xFFFFFFFF } grep { $_ >= 0 } @v, map { -$_ } @v;
};

sub sgn16 ($u) { $u >= 0x8000 ? $u - 0x10000 : $u }
sub sgn32 ($u) { $u >= 0x80000000 ? $u - 0x100000000 : $u }

# a double from its sign, biased exponent and 52-bit fraction
sub dbits ($sign, $e, $frac) { sprintf '%016X', ($sign << 63) | ($e << 52) | $frac }
sub bits_of_nv ($nv)   { uc unpack 'H16', pack 'd>', $nv }
sub nv_of_bits ($hex)  { unpack 'd>', pack 'H16', $hex }
sub next_bits ($hex, $d) {    # the neighbour, by bit pattern (sign and magnitude)
  my $u = Math::BigInt->from_hex("0x$hex");
  my $sign = $u->copy->brsft(63)->numify;
  my $mag  = $u->copy->band(Math::BigInt->from_hex('0x7FFFFFFFFFFFFFFF'));
  $mag->badd($d);
  $mag = Math::BigInt->bzero if $mag->is_neg;
  return sprintf '%016s', uc substr($mag->bior(Math::BigInt->new($sign)->blsft(63))->as_hex, 2);
}

my $ZERO   = '0000000000000000';
my $NZERO  = '8000000000000000';
my $PINF   = '7FF0000000000000';
my $NINF   = 'FFF0000000000000';
my $QNAN   = '7FF8000000000000';
my $NQNAN  = 'FFF8000000000000';
my $SNAN   = '7FF0000000000001';
my $NNANP  = 'FFF123456789ABCD';
my $MAXD   = '7FEFFFFFFFFFFFFF';
my $MIND   = '0010000000000000';
my $SUBMIN = '0000000000000001';
my $SUBMAX = '000FFFFFFFFFFFFF';

my @specials = ($ZERO, $NZERO, $PINF, $NINF, $QNAN, $NQNAN, $SNAN, $NNANP);

sub pow10_bits ($k)   { bits_of_nv("1e$k" + 0) }
sub pow2_bits ($k) {   # 2**k exactly, including subnormals, from the bit pattern
  return dbits(0, $k + 1023, 0) if $k >= -1022;
  return sprintf '%016X', Math::BigInt->bone->blsft($k + 1074)->numify;
}
sub neighbours ($hex) { (next_bits($hex, -1), $hex, next_bits($hex, 1)) }

# Ties, halves, and the values the spec names.
my @simple = map { bits_of_nv($_) } (0.5, 1.5, 2.5, 3.5, 4.5, 0.125, 0.375, 0.625, 0.875, 1.0, 2.0, 3.0, 10.0,
  100.0, 0.25, 0.75, 1.25, 8.5, 9.5, 99.5, 0.05, 0.15, 0.25, 0.35, 0.45, 0.001, 123.456, 1234567.0, 0.1, 0.2, 0.3,
  1/3, 2/3, 1e15, 1e16, 1e17, 12345678901234567890.0, 999999.5, 9999995, 0.0000099999995, 1e-5, 99999.95,
  0.00001234, 4.35, 1.005, 2.675, 1e21, 1e22, 1e23, 5e-324 * 0 + 1e-300, 3.14159265358979, 2.718281828459045,
  65536.0, 4294967296.0, 9007199254740992.0, 9007199254740993.0, 4503599627370496.5, 0.3, 1e100);
my @core = (@simple, (map { bits_of_nv(-$_) } (0.5, 2.5, 1/3, 123.456, 1e-5, 1.5)),
  $MAXD, $MIND, $SUBMIN, $SUBMAX, $ZERO, $NZERO, $PINF, $NINF, $QNAN, $NQNAN, next_bits($MAXD, -1),
  next_bits($MIND, 1), next_bits($SUBMIN, 1), next_bits(pow10_bits(0), 1), next_bits(pow10_bits(0), -1));

# ------------------------------------------------------------------ the model of the spec

sub pow10 ($n) { Math::BigInt->new(10)->bpow($n) }

# an exact binary value M * 2**E from a double's bits: ($sign, $kind, $M, $E)
sub decode ($hex) {
  my $u    = Math::BigInt->from_hex("0x$hex");
  my $sign = $u->copy->brsft(63)->numify;
  my $e    = $u->copy->brsft(52)->band(0x7FF)->numify;
  my $f    = $u->copy->band(Math::BigInt->from_hex('0xFFFFFFFFFFFFF'));
  return ($sign, 'special', $f->is_zero ? 'inf' : 'nan', 0) if $e == 2047;
  return ($sign, 'finite', $f, -1074) if $e == 0;
  return ($sign, 'finite', $f->bior(Math::BigInt->bone->blsft(52)), $e - 1075);
}

# round-half-even of M * 2**E * 10**K as a Math::BigInt
sub scaled ($m, $e, $k) {
  my $num = $m->copy;
  my $den = Math::BigInt->bone;
  $e >= 0 ? $num->blsft($e) : $den->blsft(-$e);
  $k >= 0 ? $num->bmul(pow10($k)) : $den->bmul(pow10(-$k));
  my ($q, $r) = $num->bdiv($den);
  my $twice = $r->copy->blsft(1);
  my $c     = $twice->bcmp($den);
  $q->binc if $c > 0 || ($c == 0 && $q->is_odd);
  return $q;
}

# floor(log10(M * 2**E)) for a positive value, exactly
sub floor_log10 ($m, $e) {
  my $ge = sub ($x) {    # M * 2**E >= 10**X
    my $lhs = $m->copy;
    my $rhs = Math::BigInt->bone;
    $e >= 0 ? $lhs->blsft($e) : $rhs->blsft(-$e);
    $x >= 0 ? $rhs->bmul(pow10($x)) : $lhs->bmul(pow10(-$x));
    $lhs->bcmp($rhs) >= 0;
  };
  my $est = int(log($m->numify) / log(10) + $e * log(2) / log(10));
  $est-- until $ge->($est);
  $est++ while $ge->($est + 1);
  return $est;
}

# the digits of the e style: ($digits, $exp10) with $p + 1 digits
sub e_digits ($m, $e, $p) {
  return ('0' x ($p + 1), 0) if $m->is_zero;
  my $x = floor_log10($m, $e);
  my $n = scaled($m, $e, $p - $x);
  if ($n->bcmp(pow10($p + 1)) >= 0) { $x++; $n = pow10($p) }
  return ($n->bstr, $x);
}

sub add_point ($int, $frac, $alt) { $frac ne '' || $alt ? "$int.$frac" : $int }

# the body of a floating conversion (no sign, no padding) for a finite value
sub float_body ($conv, $alt, $prec, $m, $e) {
  my $lc = lc $conv;
  my $body;
  if ($lc eq 'f') {
    my $p = $prec // 6;
    my $d = scaled($m, $e, $p)->bstr;
    $d = ('0' x ($p + 1 - length $d)) . $d if length $d < $p + 1;
    $body = add_point(substr($d, 0, length($d) - $p), substr($d, length($d) - $p), $alt);
  } elsif ($lc eq 'e') {
    my $p = $prec // 6;
    my ($d, $x) = e_digits($m, $e, $p);
    $body = add_point(substr($d, 0, 1), substr($d, 1), $alt) . sprintf('e%s%02d', $x < 0 ? '-' : '+', abs $x);
  } else {
    my $p = $prec // 6;
    $p = 1 if $p == 0;
    my ($d, $x) = e_digits($m, $e, $p - 1);
    if ($p > $x && $x >= -4) {
      my $q  = $p - 1 - $x;
      my $fd = scaled($m, $e, $q)->bstr;
      $fd = ('0' x ($q + 1 - length $fd)) . $fd if length $fd < $q + 1;
      my ($i, $f) = (substr($fd, 0, length($fd) - $q), substr($fd, length($fd) - $q));
      unless ($alt) { $f =~ s/0+$//; }
      $body = add_point($i, $f, $alt);
    } else {
      my ($i, $f) = (substr($d, 0, 1), substr($d, 1));
      unless ($alt) { $f =~ s/0+$//; }
      $body = add_point($i, $f, $alt) . sprintf('e%s%02d', $x < 0 ? '-' : '+', abs $x);
    }
  }
  return $conv =~ /[A-Z]/ ? uc $body : $body;
}

sub pad ($sign, $body, $flags, $width, $zero_ok) {
  my $len = length($sign) + length $body;
  return "$sign$body" if $len >= $width;
  return "$sign$body" . (' ' x ($width - $len)) if $flags =~ /-/;
  return $sign . ('0' x ($width - $len)) . $body if $flags =~ /0/ && $zero_ok;
  return (' ' x ($width - $len)) . "$sign$body";
}

sub signstr ($neg, $flags) { $neg ? '-' : $flags =~ /\+/ ? '+' : $flags =~ / / ? ' ' : '' }

sub fmt_double ($conv, $flags, $width, $prec, $hex) {
  my ($sign, $kind, $m, $e) = decode($hex);
  my $sg = signstr($sign, $flags);
  if ($kind eq 'special') {
    my $t = $conv =~ /[EG]/ ? uc $m : $m;
    return pad($sg, $t, $flags =~ s/0//gr, $width, 0);
  }
  return pad($sg, float_body($conv, scalar($flags =~ /#/), $prec, $m, $e), $flags, $width, 1);
}

sub fmt_int ($conv, $flags, $width, $prec, $val) {    # $val: signed for d i, unsigned otherwise
  my ($sg, $digits, $prefix) = ('', '', '');
  if ($conv =~ /[di]/) {
    $sg     = signstr($val < 0, $flags);
    $digits = abs($val) . '';
  } else {
    $digits = $conv eq 'u' ? "$val" : $conv eq 'o' ? sprintf('%o', $val) : $conv eq 'x' ? sprintf('%x', $val) : sprintf('%X', $val);
  }
  $digits = '' if defined $prec && $prec == 0 && $val == 0;
  $digits = ('0' x ($prec - length $digits)) . $digits if defined $prec && length $digits < $prec;
  if ($flags =~ /#/) {
    $digits = "0$digits" if $conv eq 'o' && $digits !~ /^0/;
    $prefix = "0$conv" if $conv =~ /[xX]/ && $val != 0;
  }
  return pad($sg . $prefix, $digits, $flags, $width, !defined $prec);
}

sub fmt_str ($flags, $width, $prec, $s) {
  $s = substr($s, 0, $prec) if defined $prec && $prec < length $s;
  return pad('', $s, $flags =~ s/0//gr, $width, 0);
}

# An argument: [i => N], [l => N], [d => HEX], [s => STRING], ['S'] (a null pointer).
# Returns ($output, $return). Follows docs/spec/fmt.md, "The format" and
# "Invalid and unsupported specifications".
our $invalid_seen;
sub model ($fmt, @args) {
  $invalid_seen = 0;
  my $out = '';
  my @in  = @args;
  my $take = sub ($types) {
    my $a = shift @in or die "model: out of arguments for '$fmt'\n";
    die "model: argument $a->[0] is not one of $types for '$fmt'\n" unless index($types, $a->[0]) >= 0;
    $a;
  };
  my $n = length $fmt;
  my $i = 0;
  while ($i < $n) {
    my $c = substr($fmt, $i, 1);
    if ($c ne '%') { $out .= $c; $i++; next }
    my $start = $i++;
    my $flags = '';
    $flags .= substr($fmt, $i++, 1) while $i < $n && substr($fmt, $i, 1) =~ /^[-+ #0]$/;
    my ($width, $wstar, $prec, $pstar, $pdot, $mod) = (0, 0, undef, 0, 0, '');
    my $bad = sub { $invalid_seen = 1; $out .= substr($fmt, $start, $i - $start + 1); $i++; };
    my $dig = sub ($j) { $j < $n && substr($fmt, $j, 1) =~ /^[0-9]$/ };
    my $invalid;
    if ($i < $n && substr($fmt, $i, 1) eq '*') {
      $wstar = 1; $i++;
      if ($dig->($i)) { $bad->(); next }
    } elsif ($dig->($i)) {
      my $d = '';
      $d .= substr($fmt, $i++, 1) while $dig->($i);
      $width = $d + 0 > 32767 ? 32767 : $d + 0;
    }
    if ($i < $n && substr($fmt, $i, 1) eq '.') {
      $pdot = 1; $i++;
      if ($i < $n && substr($fmt, $i, 1) eq '*') {
        $pstar = 1; $i++;
        if ($dig->($i)) { $bad->(); next }
      } else {
        my $d = '';
        $d .= substr($fmt, $i++, 1) while $dig->($i);
        $prec = $d eq '' ? 0 : $d + 0 > 32767 ? 32767 : $d + 0;
      }
    }
    if ($i < $n && substr($fmt, $i, 1) =~ /^[hlL]$/) {
      $mod = substr($fmt, $i++, 1);
      if ($i < $n && substr($fmt, $i, 1) =~ /^[hlL]$/) { $bad->(); next }
    }
    if ($i >= $n) { $invalid_seen = 1; $out .= substr($fmt, $start); last }
    my $conv = substr($fmt, $i, 1);
    my $between = $i - $start > 1;
    my $ok = $conv =~ /^[diuoxXeEfgG]$/ ? 1    # a modifier that does not apply is ignored
           : $conv =~ /^[cs]$/     ? $mod ne 'l'
           : $conv eq '%'          ? !$between
           : 0;
    if (!$ok) { $bad->(); next }
    $i++;
    if ($conv eq '%') { $out .= '%'; next }
    if ($wstar) {
      my $w = sgn16($take->('i')->[1] & 0xFFFF);
      if ($w < 0) { $flags .= '-'; $w = -$w }
      $width = $w > 32767 ? 32767 : $w;
    }
    if ($pstar) {
      my $p = sgn16($take->('i')->[1] & 0xFFFF);
      $prec = $p < 0 ? undef : $p;
    }
    if ($conv =~ /[diuoxX]/) {
      my $long = $mod eq 'l';
      my $a    = $take->($long ? 'l' : 'i');
      my $v    = $long ? $a->[1] & 0xFFFFFFFF : $a->[1] & 0xFFFF;
      $v = $long ? sgn32($v) : sgn16($v) if $conv =~ /[di]/;
      $out .= fmt_int($conv, $flags, $width, $prec, $v);
    } elsif ($conv eq 'c') {
      $out .= pad('', chr($take->('i')->[1] & 0xFF), $flags =~ s/0//gr, $width, 0);
    } elsif ($conv eq 's') {
      my $a = $take->('sS');
      $out .= fmt_str($flags, $width, $prec, $a->[0] eq 'S' ? '(null)' : $a->[1]);
    } else {
      $out .= fmt_double($conv, $flags, $width, $prec, $take->('d')->[1]);
    }
  }
  die "model: unused arguments for '$fmt'\n" if @in;
  return ($out, length $out);
}

# ------------------------------------------------------------------ the host oracle (--verify)

# Perl's sprintf on the same specification, for valid specifications only.
sub host ($fmt, @args) {
  my @a;
  for my $a (@args) {
    push @a, $a->[0] eq 'd' ? nv_of_bits($a->[1]) : $a->[0] eq 'S' ? undef : $a->[1];
  }
  my $f = $fmt =~ s/(?<=%)([-+ #0]*[0-9*]*(?:\.[0-9*]*)?)[hlL]+/$1/gr;
  return eval { no warnings; sprintf $f, @a };
}

# ------------------------------------------------------------------ data lines

# fields of a format (not a string argument): spaces stay, ends included
sub esc_fmt ($s) { $s =~ s{([\\\x00-\x1f\x7f-\xff])}{ my $c = $1; $c eq '\\' ? '\\\\' : $c eq "\t" ? '\\t' : $c eq "\n" ? '\\n' : $c eq "\r" ? '\\r' : sprintf '\\x%02X', ord $c }ger }
sub esc_arg ($s) { esc_fmt($s) =~ s/ /\\x20/gr }

sub arg_text ($a) {
  my ($t, $v) = @$a;
  return "i:$v" if $t eq 'i';
  return "l:$v" if $t eq 'l';
  return "d:$v" if $t eq 'd';
  return 'S:'   if $t eq 'S';
  return 's:' . esc_arg($v);
}

my $verify_bad = 0;
my $verified = 0;
sub line ($mode, $fmt, @args) {
  my ($out, $ret) = model($fmt, @args);
  if ($opt{verify} && !$invalid_seen) {
    # where Perl's sprintf is not C's: inf and nan, null strings, the 0 flag on
    # c and s, characters above 255, and lengths beyond what is useful
    my $skip = grep { $_->[0] eq 'S' || ($_->[0] eq 'd' && (decode($_->[1]))[1] eq 'special') } @args;
    $skip ||= $fmt =~ /%[-+ #]*0[^%]*?[cs]/;
    $skip ||= $fmt =~ /%[^%]*?c/ && grep { $_->[0] eq 'i' && ($_->[1] < 0 || $_->[1] > 255) } @args;
    $skip ||= length($out) > 4000;
    if (!$skip) {
      $verified++;
      my $h = host($fmt, @args);
      if (!defined $h || $h ne $out) {
        $verify_bad++;
        say STDERR "verify: '$fmt' @{[ map { arg_text($_) } @args ]}: model [", substr($out, 0, 60), "] host [", substr($h // 'undef', 0, 60), "]" if $verify_bad <= 40;
      }
    }
  }
  return join "\t", $mode, esc_fmt($fmt), join(' ', map { arg_text($_) } @args), esc_fmt($out), $ret;
}

my %set;    # file base => [lines]
sub emit ($base, $mode, $fmt, @args) {
  my $l = line($mode, $fmt, @args);
  push $set{$base}->@*, $l;
}

# ------------------------------------------------------------------ the corpus

my @flag_sets = do {
  my @f;
  for my $m (0 .. 31) { push @f, join '', map { (qw(- + ), ' ', '#', '0')[$_] } grep { $m & (1 << $_) } 0 .. 4 }
  @f;
};
my @widths = (undef, 1, 8, 30);
my @precs  = (undef, 0, 1, 6, 17, 20, 40);
sub spec ($flags, $width, $prec, $mod, $conv) { '%' . $flags . ($width // '') . (defined $prec ? ".$prec" : '') . $mod . $conv }

my $scale = $opt{scale};

# Integers: every combination of flags, width and precision, with a rotating
# choice of values, then every value with a few combinations.
sub int_set ($base, $convs, $mod, $values, $perbox, $sweep_boxes) {
  my $i = 0;
  my $long = $mod eq 'l';
  my $mk = sub ($conv, $u) {
    my $v = $conv =~ /[di]/ ? ($long ? sgn32($u) : sgn16($u)) : $u;
    [$long ? 'l' : 'i', $v];
  };
  for my $conv (@$convs) {
    my $step = 0;
    for my $f (@flag_sets) {
      for my $w (@widths) {
        for my $p (@precs) {
          for my $j (1 .. $perbox) {
            my $u = $values->[($step * 7 + $j * 13 + length($f) * 3) % @$values];
            emit($base, 'P', spec($f, $w, $p, $mod, $conv), $mk->($conv, $u));
          }
          $step++;
        }
      }
    }
    for my $box (@$sweep_boxes) {
      my ($f, $w, $p) = @$box;
      emit($base, 'P', spec($f, $w, $p, $mod, $conv), $mk->($conv, $_)) for @$values;
    }
  }
}

my @int_sweeps  = (['', undef, undef], ['+#', 12, 0], ['-0', 14, 6]);
my @long_sweeps = @int_sweeps;
int_set('intdi', [qw(d i)],   '',  \@ints16, 1, \@int_sweeps);
int_set('intuo', [qw(u o)],   '',  \@ints16, 1, \@int_sweeps);
int_set('intx',  [qw(x X)],   '',  \@ints16, 1, \@int_sweeps);
int_set('longdi', [qw(d i)],  'l', \@longs,  1, \@long_sweeps);
int_set('longuo', [qw(u o)],  'l', \@longs,  1, \@long_sweeps);
int_set('longx',  [qw(x X)],  'l', \@longs,  1, \@long_sweeps);

# h: the same as no modifier
{
  my $k = 0;
  for my $conv (qw(d i u o x X)) {
    for my $f ('', '-', '+', ' ', '#', '0', '#0', '-+') {
      for my $w (undef, 8) {
        for my $p (undef, 0, 6) {
          my $u = $ints16[($k++ * 11) % @ints16];
          emit('intmisc', 'P', spec($f, $w, $p, 'h', $conv), ['i', $conv =~ /[di]/ ? sgn16($u) : $u]);
        }
      }
    }
  }
}

# --- doubles: the cross product, a rotating choice of values
{
  my $k = 0;
  for my $conv (qw(e E f g G)) {
    for my $f (@flag_sets) {
      for my $w (@widths) {
        for my $p (@precs) {
          for my $j (1) {
            my $v = $core[($k * 7 + $j * 17 + 3) % @core];
            $k++;
            emit('dblx' . lc $conv, 'P', spec($f, $w, $p, '', $conv), ['d', $v]);
          }
        }
      }
    }
  }
}

# L is a double too
for my $conv (qw(e E f g G)) {
  my $k = 0;
  for my $f ('', '-', '+', '#', '0', ' ') {
    for my $p (undef, 0, 3, 17) {
      emit('dblmisc', 'P', spec($f, 14, $p, 'L', $conv), ['d', $core[($k++ * 9 + 4) % @core]]);
    }
  }
}

# --- the specials with every flag
