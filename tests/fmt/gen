  }

  # %c: every kind of byte, widths
  for my $ch (0, 1, 7, 9, 10, 13, 26, 31, 32, 37, 65, 97, 126, 127, 128, 200, 255, 256, 321, 65535, -1, -127, -128) {
    for my $f ('', '-', '0') {
      for my $w (undef, 1, 4) {
        emit('misc', 'P', spec($f, $w, undef, '', 'c'), ['i', $ch]);
      }
    }
  }

  # invalid and unsupported specifications (copied as written, no argument consumed)
  my @bad = (
    ['%n'], ['a%nb'], ['%p'], ['%a'], ['%A'], ['%F'], ['%ls'], ['%lc'], ['%lld'], ['%lli'], ['%llu'],
    ['%hhd'], ['%hld'], ['%lhd'], ['%Lld'], ['%hh'], ['%ll'], ['%lL'],
    ['%z'], ['%y%d', ['i', 9]], ['%5z%d', ['i', 9]], ['%-*z%d', ['i', 9]], ['%*5d'], ['%.*5d'], ['%**d'],
    ['%.5.3d'], ['%5-d'], ['%.5 d'], ['% %'], ['%5%'], ['%-%'], ['%.1%'], ['%l%'], ['%'], ['abc%'], ['%5'], ['%-'], ['%.'], ['%.5'], ['%*'], ['%.*'],
    ['%l'], ['%h'], ['%L'], ['%-5.3'], ['%q%q'], ['%[x]'], ['%@'], ['100%'], ['%d%', ['i', 4]], ['%d%n%d', ['i', 1], ['i', 2]], ['%s%n', ['s', 'ab']],
    ['%i%lli%i', ['i', 1], ['i', 3]], ['%ld%lld%ld', ['l', 1], ['l', 3]],
    ['%e%p%e', ['d', bits_of_nv(1.5)], ['d', bits_of_nv(2.5)]],
    ['%0*d%*z', ['i', 5], ['i', 3]], ['%hc'], ['%Ls'], ['%lf'], ['%hf'], ['%Ld'],
  );
  # the last five are ambiguous in the spec (a modifier with a conversion it is not listed for): not in the corpus
  pop @bad for 1 .. 5;
  for my $b (@bad) {
    my ($f, @a) = @$b;
    emit('misc', 'P', $f, @a);
  }
  emit('misc', 'P', '%*c%c', ['i', 3], ['i', 65], ['i', 66]);
}

# --- snprintf and vsnprintf with n of 0, 1, the length, one less and one more
{
  my @bases = (
    ['%d', ['i', 12345]], ['%s', ['s', 'hello world']], ['%10d', ['i', -42]], ['[%-12s]', ['s', 'left']], ['%f', ['d', bits_of_nv(3.14159)]],
    ['%e', ['d', bits_of_nv(-0.000123)]], ['%g', ['d', $PINF]], ['%.20g', ['d', bits_of_nv(0.1)]], ['abc', ], ['', ], ['%c', ['i', 65]], ['%c%c', ['i', 0], ['i', 66]],
    ['%x|%o|%u', ['i', 0xabc], ['i', 8], ['i', 65535]], ['%%'], ['%#lx', ['l', 0xdeadbeef]], ['value=%+d, text=%s!', ['i', 7], ['s', 'seven']], ['%n'], ['%5%'],
    ['%.30f', ['d', bits_of_nv(1.0)]], ['%.300f', ['d', bits_of_nv(1.0)]], ['%*d', ['i', 40], ['i', 1]], ['%s', ['S']],
  );
  for my $b (@bases) {
    my ($f, @a) = @$b;
    my ($out) = model($f, @a);
    my $len = length $out;
    my %ns = map { $_ => 1 } grep { $_ >= 0 } (0, 1, 2, 3, $len - 2, $len - 1, $len, $len + 1, $len + 2, $len + 9);
    emit('snp', "N$_", $f, @a) for sort { $::a <=> $::b } keys %ns;
    emit('snp', 'P', $f, @a);
  }
}

# --- the integral value cross-check (tests/fmt/fastpath.c)
{
  my @ivals = (0, 1, 2, 3, 5, 9, 10, 11, 99, 100, 101, 255, 256, 999, 1000, 9999, 10000, 32767, 32768, 65535, 65536, 99999, 100000, 999999, 1000000, 16777215, 16777216,
