  emit('misc', 'P', '%c%c%c', ['i', 0], ['i', 65], ['i', 0]);

  # %s: widths, precisions, empty, null pointers
  for my $s ('', 'a', 'abc', 'hello world', 'with  two spaces', "tab\there", 'x' x 40, "\xe9\xff") {
    for my $f ('', '-', '0', '-0') {
      for my $w (undef, 1, 5, 8, 30) {
        for my $p (undef, 0, 1, 3, 40) {
