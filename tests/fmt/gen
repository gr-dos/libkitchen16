# --- powers of ten and two, each with both neighbours, over the whole range
{
  my $step = 5 * $scale;
  my @p10 = grep { $_ % $step == 0 || abs($_) >= 300 || $_ == -1 || $_ == 1 } (-323 .. 308);
  my @p2  = grep { $_ % (11 * $scale) == 0 || $_ >= 1020 || $_ <= -1070 || abs($_) <= 3 } (-1074 .. 1023);
  my @vals = map { neighbours(pow10_bits($_)) } @p10;
  push @vals, map { neighbours(pow2_bits($_)) } @p2;
  push @vals, map { neighbours(bits_of_nv(-(1e0 * 10**$_))) } (-3 .. 3);
  my @fmts = (['', undef, 17, 'g'], ['', undef, 20, 'g'], ['', undef, undef, 'e'], ['', undef, undef, 'f'], ['', undef, undef, 'g'], ['', undef, 0, 'f']);
  my $k = 0;
  for my $v (@vals) {
    # each value with three of the formats, rotating, so that all get each
    for my $j (0 .. 2) {
      my $f = $fmts[($k + $j * 2) % @fmts];
      emit('dblpow', 'P', spec($f->[0], $f->[1], $f->[2], '', $f->[3]), ['d', $v]);
    }
    $k++;
  }
  # a few at length
  for my $v ((map { pow10_bits($_) } (-323, -300, -100, -10, -1, 0, 1, 10, 22, 23, 100, 200, 300, 308)), $MAXD, $MIND, $SUBMIN, $SUBMAX) {
    emit('dblpow', 'P', '%.30f',  ['d', $v]);
    emit('dblpow', 'P', '%.40e',  ['d', $v]);
    emit('dblpow', 'P', '%.100g', ['d', $v]);
  }
}

