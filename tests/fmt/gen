for my $base (sort keys %set) {
  my @l = $set{$base}->@*;
  my $max = $max_lines{$base} // $max_lines{default};
  my $parts = int((@l + $max - 1) / $max);
  my $per   = int((@l + $parts - 1) / $parts);
  for my $p (0 .. $parts - 1) {
    my @chunk = splice @l, 0, $per;
    my $name = $parts == 1 ? "$base.dat" : sprintf('%s%d.dat', $base, $p + 1);
    die "name $name is not 8.3\n" unless $name =~ /^[a-z0-9]{1,8}\.dat$/;
    write_file("$opt{out}/$name", join '', map { "$_\n" } @chunk);
    push @names, [$name, scalar @chunk];
  }
}
say "$_->[0] $_->[1]" for @names;

make_path("$opt{fmtio}/data");
{
  my (@dat, @exp);
  for my $c (@pc) {
    my ($fmt, @a) = @$c;
    my ($out) = model($fmt, @a);
    push @dat, join "\t", 'P', esc_fmt($fmt), join(' ', map { arg_text($_) } @a), esc_fmt($out), length $out;
    push @exp, "$out|";
  }
  push @exp, "ok";
  write_file("$opt{fmtio}/data/pc.dat", join '', map { "$_\n" } @dat);
  write_file("$opt{fmtio}/pc.expect", join '', map { "$_\n" } @exp);
}
