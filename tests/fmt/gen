  emit('misc', 'P', 'x%sy%sz', ['S'], ['s', 'mid']);
  # a null pointer is the string (null): the precision truncates it (docs/spec/fmt.md, "Choices beyond the C standard")
  for my $p (0, 1, 3, 5) {
    for my $w (undef, 8) {
      emit('misc', 'P', spec('', $w, $p, '', 's'), ['S']);
      emit('misc', 'P', spec('-', $w, $p, '', 's'), ['S']);
    }
  }
  emit('misc', 'P', '[%.3s][%.0s][%8.2s]', ['S'], ['S'], ['S']);
  # a length modifier that does not apply to the conversion is accepted and ignored
  for my $m ('l', 'h', 'L') {
    for my $c ('f', 'e', 'g', 'E', 'G') {
      emit('misc', 'P', "%$m$c|%.3$m$c|%10.1$m$c", ['d', bits_of_nv(3.14159)], ['d', bits_of_nv(-2.5)], ['d', bits_of_nv(1e22)]);
