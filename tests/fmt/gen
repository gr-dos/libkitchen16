# --- a seeded pseudo-random set of bit patterns
{
  my $x = 0x9E3779B97F4A7C15;
  my $rnd = sub {
    $x ^= ($x << 13) & 0xFFFFFFFFFFFFFFFF;
    $x ^= $x >> 7;
    $x ^= ($x << 17) & 0xFFFFFFFFFFFFFFFF;
    $x;
  };
  my @vals;
  while (@vals < 30 * $scale) {    # any exponent
    my $u = $rnd->();
    next if (($u >> 52) & 0x7FF) == 0x7FF;
    push @vals, sprintf '%016X', $u;
  }
  while (@vals < 60 * $scale) {    # exponents near 0
    my $u = $rnd->();
    my $e = 1023 - 40 + ($rnd->() % 80);
    push @vals, sprintf '%016X', ($u & 0x800FFFFFFFFFFFFF) | ($e << 52);
  }
  for my $v (@vals) {
    emit('dblrand', 'P', $_, ['d', $v]) for ('%.17g', '%.20g', '%.0f', '%e', '%f', '%g');
  }
}

# --- * widths and precisions, %%, strings and characters, invalid specifications
{
  my @iv = (0, 1, -1, 7, 8, 12, -12, 30, -30, 32767, -32767, -32768, 100);
