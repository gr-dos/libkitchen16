      }
    }
  }
  for my $f ('', '-') {
    for my $w (undef, 1, 8, 30) {
      emit('misc', 'P', spec($f, $w, undef, '', 's'), ['S']);
      emit('misc', 'P', spec($f, $w, 6, '', 's'), ['S']);
      emit('misc', 'P', spec($f, $w, 40, '', 's'), ['S']);
    }
