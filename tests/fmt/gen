  emit('misc', 'P', '[%*.*s]', ['i', 8], ['i', 2], ['s', 'hello']);
  emit('misc', 'P', '[%-*.*ld]', ['i', 12], ['i', 8], ['l', -123456]);
  emit('misc', 'P', '[%*d|%*d|%*d]', ['i', 3], ['i', 1], ['i', -3], ['i', 2], ['i', 0], ['i', 3]);

  emit('misc', 'P', '%%');
  emit('misc', 'P', '100%%');
  emit('misc', 'P', '%%%%');
  emit('misc', 'P', '%%d');
  emit('misc', 'P', '%d%%%d', ['i', 1], ['i', 2]);
  emit('misc', 'P', '');
  emit('misc', 'P', 'no conversions at all');
  emit('misc', 'P', 'a%cb%cc', ['i', 65], ['i', 66]);
