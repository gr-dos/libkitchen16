# ---- --verify: the oracle against an independent computation ----
#
# Math::BigFloat at 60 digits computes sin cos tan atan exp log sqrt and pow
# (and from them the others) for a sample of the rows with a moderate
# argument, and the host's result is compared with it in units of the last
# place. Prints the worst error found per function and every row beyond 1.5.

sub verify_oracle ($every) {
  require Math::BigFloat;
  Math::BigFloat->accuracy(45);
  $| = 1;
  my $bf = sub ($d) { Math::BigFloat->new(sprintf '%.25e', $d) };
  my $exact = sub ($d) {    # the exact value of a double as a BigFloat
    my ($m, $e) = POSIX::frexp($d);
    my $mi = Math::BigInt->new(sprintf '%.0f', POSIX::ldexp($m, 53));
    Math::BigFloat->new($mi)->bmul(Math::BigFloat->new(2)->bpow($e - 53));
  };
  my $ln10 = Math::BigFloat->new(10)->blog;
  my $pi   = Math::BigFloat->bpi(45);
  my %f = (
    sin   => sub ($x) { $x->copy->bsin },
    cos   => sub ($x) { $x->copy->bcos },
    tan   => sub ($x) { $x->copy->bsin->bdiv($x->copy->bcos) },
    atan  => sub ($x) { $x->copy->batan },
    exp   => sub ($x) { $x->copy->bexp },
    log   => sub ($x) { $x->copy->blog },
    log10 => sub ($x) { $x->copy->blog->bdiv($ln10) },
    sqrt  => sub ($x) { $x->copy->bsqrt },
    sinh  => sub ($x) { my $e = $x->copy->bexp; my $i = scalar Math::BigFloat->new(1)->bdiv($e); scalar $e->bsub($i)->bdiv(2) },
    cosh  => sub ($x) { my $e = $x->copy->bexp; my $i = scalar Math::BigFloat->new(1)->bdiv($e); scalar $e->badd($i)->bdiv(2) },
    tanh  => sub ($x) { my $e = $x->copy->bmul(2)->bexp; my $d = $e->copy->badd(1); scalar $e->bsub(1)->bdiv($d) },
  );
  # asin and acos from atan2 are awkward in Math::BigFloat: use the identity
  # asin x = atan(x / sqrt(1 - x^2)), acos x = pi/2 - asin x
  $f{asin} = sub ($x) { $x->copy->bdiv(Math::BigFloat->new(1)->bsub($x->copy->bmul($x))->bsqrt)->batan };
  $f{acos} = sub ($x) { $pi->copy->bdiv(2)->bsub($f{asin}->($x)) };
  my %worst;
  my $n = 0;
  for my $file (grep { $_ ne 'errno.dat' && $_ !~ /^p2/ } sort keys %rows) {
    for my $line ($rows{$file}->@*) {
      my ($fn, $a, $r) = split ' ', $line;
      next unless $f{$fn} && $r ne 'nan';
      next if ++$n % $every;
      my ($x, $want) = (num($a), num($r));
      next unless isfin($x) && isfin($want) && $want != 0;
      next if abs($x) > 1e6 && $fn =~ /^(?:sin|cos|tan)$/;
      next if abs($x) > 700;
      next if $fn =~ /^(?:sin|cos|tan)$/ && (abs($x) > 8 || abs($want) < 1e-6);
      next if $fn =~ /^(?:sin|cos|tan|asin|acos|atan|exp|log|log10)$/ && abs($x) < 1e-10 && $x != 0 && 0;
      next if $fn =~ /^(?:sin|cos|tan)$/ && abs($x) > 1e4;
      next if $fn =~ /^(?:sinh|cosh)$/ && abs($x) > 300;
      my $v = $f{$fn}->($exact->($x));
      # one unit in the last place of the exact value
      my $av = $v->copy->babs;
      next if $av->is_zero;
      my $e = POSIX::floor(log(abs($want)) / $LN2 + 1e-9);
      my $ulp = 2**(($e < -1022 ? -1022 : $e) - 52);
      my $err = $exact->($want)->bsub($v)->babs->bdiv($exact->($ulp));
      $err = $err->numify;
      $worst{$fn} = [$err, $line] if !$worst{$fn} || $err > $worst{$fn}[0];
      say "BAD $line: $err ulp" if $err > 1.5;
    }
  }
  # pow and atan2, the same way, over rows with finite non-zero results
  for my $file (qw(pow.dat atan2.dat)) {
    my $k = 0;
    for my $line ($rows{$file}->@*) {
      my ($fn, $a, $b, $r) = split ' ', $line;
      next if $r eq 'nan' || ++$k % $every;
      my ($x, $y, $want) = (num($a), num($b), num($r));
      next unless isfin($x) && isfin($y) && isfin($want) && $want != 0;
      next if abs($want) < 1e-290 || abs($x) < 1e-290 || abs($y) > 1e6 || abs($x) > 1e290;
      my $v;
      if ($fn eq 'atan2') {
        next if $x == 0 || abs($y) < 1e-290;
        $v = scalar $exact->($y)->batan2($exact->($x));
      } else {
        next if $x <= 0 && !is_int($y);
        my $bx = $exact->($x);
        $v = $x < 0 ? scalar($exact->(-$x)->bpow($exact->($y))) : scalar($bx->copy->bpow($exact->($y)));
        $v->bneg if $x < 0 && is_odd($y);
      }
      my $e = POSIX::floor(log(abs($want)) / $LN2 + 1e-9);
      my $ulp = 2**(($e < -1022 ? -1022 : $e) - 52);
      my $err = $exact->($want)->bsub($v)->babs->bdiv($exact->($ulp))->numify;
      $worst{$fn} = [$err, $line] if !$worst{$fn} || $err > $worst{$fn}[0];
      say "BAD $line: $err ulp" if $err > 1.5;
    }
  }
  say sprintf '%-6s worst %.3f ulp  %s', $_, $worst{$_}[0], $worst{$_}[1] for sort keys %worst;
}
