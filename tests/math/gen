  for my $x (0.0, -0.0, 1, -1, 2, 0.1, -0.1, 1e300, 1e-300, $SUB_MIN, -$SUB_MIN, $DBL_MAX, -$DBL_MAX, $INF, $NINF, num($NANS[0]), 3.14159, -2.5) { emit2($f, 'pow', $x, 0.0); emit2($f, 'pow', $x, -0.0); emit2($f, 'pow', $x, 1) if !isnan($x) }
  emit2($f, 'pow', 1, num($NANS[0]));
  # integer powers whose exact result is a double: every base -12 .. 40 up to
  # its largest exact power (the odd part's power at most 2^53, the whole at
  # most DBL_MAX), the expected value computed in integers
  require Math::BigInt;
  my $maxd = Math::BigInt->new(2)->bpow(1024)->bsub(Math::BigInt->new(2)->bpow(971));
  for my $x (-12 .. 40) {
    next if $x == 0;
    my $o = abs $x;
